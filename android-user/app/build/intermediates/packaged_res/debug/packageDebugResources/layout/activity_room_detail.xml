<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ảnh + nút quay lại + yêu thích -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="#FFE4EF">

                <ImageView
                    android:id="@+id/imgRoom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFE4EF"
                    android:contentDescription="Ảnh phòng"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Quay lại"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#24242B"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/btnFavorite"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Yêu thích"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#F54C91"
                    android:textSize="28sp" />

            </FrameLayout>

            <!-- Loading -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="#FF69A6" />

            <!-- Nội dung phòng -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Loại phòng và trạng thái -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtRoomType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FFE4EF"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Phòng trọ"
                        android:textColor="#F54C91"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtRoomStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#E8F6EC"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Còn trống"
                        android:textColor="#26834C"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Tên phòng -->
                <TextView
                    android:id="@+id/txtRoomTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phòng trọ N&amp;N Home"
                    android:textColor="#24242B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Địa chỉ -->
                <TextView
                    android:id="@+id/txtRoomAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Địa chỉ phòng trọ"
                    android:textColor="#888888"
                    android:textSize="14sp" />

                <!-- Giá phòng -->
                <TextView
                    android:id="@+id/txtRoomPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="3.500.000 VNĐ/tháng"
                    android:textColor="#F54C91"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Thông tin phòng -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Thông tin phòng"
                    android:textColor="#24242B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:id="@+id/layoutRoomInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Diện tích: 25 m²"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Số người ở tối đa: 2"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tiện ích -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Tiện ích"
                    android:textColor="#24242B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Entry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Máy lạnh"
                        app:chipBackgroundColor="#FFE4EF"
                        app:chipIconVisible="false"
                        app:closeIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Entry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wi-Fi"
                        app:chipBackgroundColor="#FFE4EF"
                        app:chipIconVisible="false"
                        app:closeIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Entry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chỗ để xe"
                        app:chipBackgroundColor="#FFE4EF"
                        app:chipIconVisible="false"
                        app:closeIconVisible="false" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Mô tả -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Mô tả"
                    android:textColor="#24242B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Phòng sạch sẽ, thoáng mát, đầy đủ tiện nghi, phù hợp cho sinh viên và người đi làm."
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <!-- Chủ nhà -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chủ nhà"
                                android:textColor="#888888"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtLandlord"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="N&amp;N Home"
                                android:textColor="#24242B"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCall"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Gọi điện"
                            android:textAllCaps="false"
                            android:textColor="#F54C91"
                            app:cornerRadius="12dp"
                            app:strokeColor="#FF69A6" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút hành động -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/txtUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Phòng này hiện không còn trống"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookAppointment"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Đặt lịch xem"
                android:textAllCaps="false"
                android:textColor="#F54C91"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="#FF69A6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRent"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Thuê phòng"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:backgroundTint="#FF69A6"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
