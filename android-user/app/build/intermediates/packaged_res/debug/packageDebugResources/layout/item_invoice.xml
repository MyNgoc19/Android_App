<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEE9EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tháng hóa đơn và trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtInvoiceMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hóa đơn tháng 11/2026"
                android:textColor="#202027"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInvoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF0D9"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Chưa thanh toán"
                android:textColor="#B7791F"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tên phòng -->
        <TextView
            android:id="@+id/txtInvoiceRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Phòng trọ N&amp;N Home - P101"
            android:textColor="#55545C"
            android:textSize="14sp" />

        <!-- Điện nước và dịch vụ -->
        <TextView
            android:id="@+id/txtInvoiceUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tiền phòng, điện, nước và dịch vụ"
            android:textColor="#929097"
            android:textSize="12sp" />

        <!-- Đường phân cách -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#F1EDF0" />

        <!-- Hạn thanh toán và tổng tiền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtInvoiceDue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hạn thanh toán: 25/11/2026"
                android:textColor="#929097"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtInvoiceTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.850.000đ"
                android:textColor="#FF4F91"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
