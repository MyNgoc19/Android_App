<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#EEE9EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== ẢNH PHÒNG ==================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/imgRoom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFEAF2"
                android:contentDescription="Ảnh phòng"
                android:scaleType="centerCrop" />

            <!-- Loại phòng -->
            <TextView
                android:id="@+id/txtRoomType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="Phòng trọ"
                android:textColor="#FF4F91"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Nút yêu thích -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/btnFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Yêu thích"
                    android:padding="10dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#FF4F91" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- ==================== THÔNG TIN PHÒNG ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tên phòng -->
            <TextView
                android:id="@+id/txtRoomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Phòng trọ N&amp;N Home - P101"
                android:textColor="#202027"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Địa chỉ -->
            <TextView
                android:id="@+id/txtRoomAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Quận 7, TP. Hồ Chí Minh"
                android:textColor="#929097"
                android:textSize="13sp" />

            <!-- Đường phân cách -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="#F1EDF0" />

            <!-- Giá phòng và diện tích -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtRoomPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3.500.000đ/tháng"
                    android:textColor="#FF4F91"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRoomArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 m²"
                    android:textColor="#929097"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
