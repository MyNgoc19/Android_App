<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="NN" />



    <style name="NN.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="NN.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nn_gray</item>
    </style>

    <style name="NN.SectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nn_text</item>
    </style>

    <style name="NN.Input"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/nn_primary</item>
    </style>

    <style name="NN.PrimaryButton"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/nn_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>




    <style name="NN.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nn_text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>


    <style name="NN.OutlineButton"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/nn_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/nn_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="NN.StatusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="NN.FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">#EAE7EA</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
