
# APPLICATION

APP_NAME=Room Rental Management System
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# DATABASE - PostgreSQL

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/room_rental_db

# FIREBASE AUTHENTICATION

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# FIREBASE STORAGE

FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket

# REDIS (OPTIONAL)

REDIS_URL=redis://localhost:6379/0
